{
  // Run with Ctrl+Shift+B (build) or Terminal > Run Task.
  // Every task acts on the lab folder of the file you have open.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lab: build",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "lab: test",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "lab: test reference solution",
      "type": "shell",
      "command": "make test IMPL=solution",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "test"
    },
    {
      "label": "lab: debug build (07/08)",
      "type": "shell",
      "command": "make debug",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"]
    },
    {
      // Crashes ./seg with core dumps enabled, then points core.latest at the
      // newest core so the launch configuration has a fixed path to open.
      "label": "lab: collect core (01)",
      "type": "shell",
      "command": "make && (ulimit -c unlimited; ./seg; ln -sf \"$(ls -t core.seg.* | head -1)\" core.latest && test -e core.latest)",
      "options": { "cwd": "${workspaceFolder}/labs/01-segfault-core" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "lab: benchmark SPSC (07)",
      "type": "shell",
      "command": "make bench",
      "options": { "cwd": "${workspaceFolder}/labs/07-spsc-queue" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
